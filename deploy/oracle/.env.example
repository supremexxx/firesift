PYRORISK_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
# Non-secret scientific snapshot provenance. Pin these to the deployed image.
ERYTHEON_ENVIRONMENT=production
ERYTHEON_GIT_REVISION=REPLACE_WITH_FULL_GIT_SHA
ERYTHEON_IMAGE_REFERENCE=ghcr.io/OWNER/REPOSITORY:sha-REPLACE_WITH_SHORT_SHA
ERYTHEON_IMAGE_DIGEST=sha256:REPLACE_WITH_IMAGE_DIGEST
PYRORISK_DOMAIN=:80
# No bundled web interface exists as of 2026-08-30 (all removed, to be
# rebuilt from scratch) -- this flag now only gates the scheduler's BLUE
# evidence-archiving background tasks, not any HTTP route.
BLUE_CENTER_ENABLED=false
BLUE_AI_EVIDENCE_ENABLED=false
BLUE_FEUX_DE_FORET_ENABLED=false
BLUE_OPENAI_MODEL=gpt-4o-mini
# Required only when BLUE_AI_EVIDENCE_ENABLED=true. Never commit a real key.
OPENAI_API_KEY=

POSTGRES_DB=pyrorisk
POSTGRES_USER=pyrorisk
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

FIRMS_MAP_KEY=
METEOFRANCE_API_KEY=

# Keep the Aude pilot until the France-resolution-8 pipeline is benchmarked.
DATA_PROFILE=fixture
AOI_BBOX=1.68,42.57,3.26,43.46
H3_RESOLUTION=9
TERRITORY_GEOJSON_PATH=
TERRITORY_CODES=
TERRITORY_LABEL=Aude · Occitanie
OSM_PATH=/app/testdata/osm_features.csv
BDIFF_PATH=/app/testdata/bdiff_aude.csv
PROMETHEE_PATH=/app/testdata/promethee_aude.csv
# Official portal selection and ZIP endpoints. The last closed year is selected automatically.
BDIFF_SEARCH_URL=https://bdiff.agriculture.gouv.fr/incendies
BDIFF_EXPORT_URL=https://bdiff.agriculture.gouv.fr/incendies/zip
BDIFF_HISTORY_FROM_YEAR=2020
BDIFF_HISTORY_TO_YEAR=
# Safety limits for server-side synchronization.
BDIFF_MIN_ROWS=500
BDIFF_MAX_BYTES=104857600
BDIFF_MIN_FREE_KIB=1048576
BDIFF_MAX_REJECT_RATIO=0.01
HUMAN_MODEL_NEGATIVES_PER_POSITIVE=4
CORINE_PATH=/app/testdata/corine_aude.csv
INSEE_PATH=/app/testdata/insee_filosofi_200m.csv
CALENDAR_PATH=/app/testdata/calendar_zone_c.csv
WEATHER_IDW_POWER=2.0
RECOMPUTE_INTERVAL_SECS=900

FWI_MAX=30.0
RISK_ALPHA=0.6
RISK_BETA=0.4
RISK_W_HIST=0.4
RISK_W_WUI=0.25
RISK_W_ROAD=0.2
RISK_W_AGRI=0.15
RUST_LOG=info,pyrorisk=info

# Optional Cloudflare R2 backup credentials.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=pyrorisk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

{$PYRORISK_DOMAIN} {
	encode zstd gzip

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	@favicon path /favicon.ico

	handle @favicon {
		respond 204
	}

	# No bundled web interface exists as of 2026-08-30 (all removed, to be
	# rebuilt from scratch) -- /science and /blue no longer resolve to
	# anything, so there is nothing left to gate behind Basic Auth here.
	handle {
		reverse_proxy app:8080
	}
}
